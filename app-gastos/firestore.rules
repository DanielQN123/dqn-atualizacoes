rules_version = '2';

// Cada pessoa só lê e grava os próprios dados, em usuarios/{seu id}/...
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /gastos/{gastoId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.valor is number
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 80
          && request.resource.data.data is string
          && request.resource.data.cat is string;
      }
    }
  }
}
